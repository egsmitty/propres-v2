# REPO-36. package.json already pins engines.node >= 22.12.0 and every CI
# workflow reads Node from .nvmrc (22); electron/main/__tests__/toolchain.test.ts
# guards that .nvmrc, engines.node, and @types/node agree on the major. This
# makes the pin load-bearing locally and in `npm ci` too, instead of only
# being advisory.
engine-strict=true
